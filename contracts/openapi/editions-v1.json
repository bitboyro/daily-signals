{
  "openapi": "3.0.3",
  "info": { "title": "Daily Signals Edition API", "version": "1.0.0" },
  "paths": {
    "/api/editions": {
      "get": {
        "responses": {
          "200": {
            "description": "Newest-first archived editions",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EditionList" }
              }
            }
          }
        }
      }
    },
    "/api/producer/script": {
      "get": {
        "security": [{ "producerBearer": [] }],
        "responses": { "200": { "description": "Current producer script draft", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ScriptDraft" } } } } }
      },
      "put": {
        "security": [{ "producerBearer": [] }],
        "requestBody": { "required": true, "content": { "text/plain": { "schema": { "type": "string", "minLength": 1, "maxLength": 20000 } } } },
        "responses": { "200": { "description": "Saved producer script draft", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ScriptDraft" } } } } }
      }
    },
    "/api/producer/edition": {
      "get": {
        "security": [{ "producerBearer": [] }],
        "responses": { "200": { "description": "Current producer edition state", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProducerEditionState" } } } } }
      },
      "post": {
        "security": [{ "producerBearer": [] }],
        "requestBody": { "required": true, "content": { "text/plain": { "schema": { "type": "string", "enum": ["APPROVE", "PUBLISH"] } } } },
        "responses": { "200": { "description": "Transitioned producer edition", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProducerEditionState" } } } } }
      }
    }
  },
  "components": {
    "securitySchemes": { "producerBearer": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" } },
    "schemas": {
      "ScriptDraft": {
        "type": "object",
        "required": ["schemaVersion", "text", "revision"],
        "properties": {
          "schemaVersion": { "type": "integer", "enum": [1] },
          "text": { "type": "string", "minLength": 1, "maxLength": 20000 },
          "revision": { "type": "integer", "minimum": 0 }
        }
      },
      "ProducerEditionState": {
        "type": "object",
        "required": ["schemaVersion", "editionId", "status", "revision"],
        "properties": {
          "schemaVersion": { "type": "integer", "enum": [1] },
          "editionId": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["DRAFT", "READY", "PUBLISHED", "FAILED"] },
          "revision": { "type": "integer", "minimum": 0 }
        }
      },
      "EditionList": {
        "type": "object",
        "required": ["schemaVersion", "editions"],
        "properties": {
          "schemaVersion": { "type": "integer", "enum": [2] },
          "editions": { "type": "array", "items": { "$ref": "#/components/schemas/EditionSummary" } }
        }
      },
      "EditionSummary": {
        "type": "object",
        "required": ["editionId", "airDate", "title", "audioPath"],
        "properties": {
          "editionId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "airDate": { "type": "string", "format": "date" },
          "title": { "type": "string", "minLength": 1 },
          "audioPath": { "type": "string", "pattern": "^/" }
        }
      }
    }
  }
}
