{
  "name": "daily-signals-web",
  "version": "0.1.0",
  "private": true,
  "description": "Listener and producer client for Daily Signals",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp -R public/. dist/",
    "test": "mkdir -p reports && node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/web-unit.xml test/*.test.ts",
    "e2e": "mkdir -p reports && node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/web-e2e.xml e2e/*.test.ts"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
