# Shared runtime settings for both containers. Host-run smoke checks override only bind addresses.
DAILY_SIGNALS_BIND_ADDRESS=0.0.0.0
DAILY_SIGNALS_WEB_ROOT=/app/web
STREAMER_BIND_ADDRESS=0.0.0.0
# Listener-readable object key prefixes; drafts and staging objects stay private.
# The published demo edition is served from the fixtures/ prefix.
STREAMER_PUBLIC_PREFIXES=editions/,fixtures/
