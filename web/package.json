{
  "name": "daily-signals-web",
  "version": "1.0.0",
  "private": true,
  "description": "Listener and producer client for Daily Signals",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "npm run locales:check && tsc -p tsconfig.json && cp -R public/. dist/",
    "locales:generate": "node tools/generate-messages.mjs",
    "locales:check": "node tools/generate-messages.mjs --check",
    "bundle:budget": "npm run build && node tools/check-bundle-budget.mjs",
    "release:package": "npm run build && python3 ../tools/package-listener.py",
    "test": "mkdir -p reports && node --test --experimental-test-coverage --test-coverage-include='src/**' --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/web-unit.xml --test-reporter=lcov --test-reporter-destination=reports/web-unit.lcov test/*.test.ts",
    "e2e": "mkdir -p reports && node --test --experimental-test-coverage --test-coverage-include='src/**' --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/web-e2e.xml --test-reporter=lcov --test-reporter-destination=reports/web-e2e.lcov e2e/*.test.ts",
    "pwa:check": "mkdir -p reports && node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/pwa-check.xml pwa/*.test.ts",
    "browser:e2e": "playwright test",
    "a11y": "playwright test --config=playwright.a11y.config.ts",
    "visual": "playwright test --config=playwright.visual.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "1.65.1",
    "typescript": "7.0.2"
  }
}
