<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>ro.bitboy</groupId><artifactId>daily-signals</artifactId><version>0.1.0-SNAPSHOT</version></parent>
  <artifactId>radio-editorial</artifactId>
  <dependencies><dependency><groupId>ro.bitboy</groupId><artifactId>radio-ingestion</artifactId><version>${project.version}</version></dependency><dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency></dependencies>
  <profiles>
    <profile>
      <id>mutation</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-maven</artifactId>
            <version>1.30.1</version>
            <dependencies>
              <dependency>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-junit5-plugin</artifactId>
                <version>1.2.3</version>
              </dependency>
            </dependencies>
            <configuration>
              <targetClasses><param>ro.bitboy.dailysignals.CandidateReview*</param></targetClasses>
              <targetTests><param>ro.bitboy.dailysignals.CandidateReviewTest</param></targetTests>
              <mutationThreshold>70</mutationThreshold>
              <threads>2</threads>
              <timestampedReports>false</timestampedReports>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
