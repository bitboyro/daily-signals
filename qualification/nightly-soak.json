{
  "schemaVersion": 1,
  "iterations": 5,
  "maximumDurationSeconds": 1800,
  "tasks": [
    {
      "name": "daily-fetch-schedule",
      "command": ["mvn", "-B", "-ntp", "-pl", "radio-ingestion", "-am", "-Dtest=DailyFetchSchedulerSoakTest", "-Dsurefire.failIfNoSpecifiedTests=false", "test"]
    },
    {
      "name": "editorial-schedule",
      "command": ["mvn", "-B", "-ntp", "-pl", "radio-edition", "-am", "-Dtest=CandidateOrderingPropertyTest,ScheduledEditionClockTest", "-Dsurefire.failIfNoSpecifiedTests=false", "test"]
    },
    {
      "name": "streamer-manifest",
      "command": ["cargo", "test", "--manifest-path", "streamer/Cargo.toml", "manifest"]
    },
    {
      "name": "listener-unit",
      "command": ["npm", "--prefix", "web", "test"]
    }
  ]
}
