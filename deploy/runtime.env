# Shared runtime settings for both containers. Host-run smoke checks override only bind addresses.
DAILY_SIGNALS_BIND_ADDRESS=0.0.0.0
DAILY_SIGNALS_WEB_ROOT=/app/web
DAILY_SIGNALS_SETUP_PATH=/data/setup.json
# The setup wizard switches to this pinned local provider when Kokoro is selected.
# Start it with: docker compose --profile kokoro up --build
DAILY_SIGNALS_KOKORO_ENDPOINT=http://kokoro:8880
DAILY_SIGNALS_KOKORO_MODEL_REVISION=9e1746465742d780a70ac81d01a334c9f8e0bbb3
DAILY_SIGNALS_KOKORO_MODEL_SHA256=496dba118d1a58f5f3db2efc88dbdc216e0483fc89fe6e47ee1f2c53f18ad1e4
DAILY_SIGNALS_KOKORO_VOICE_ID=af_heart
DAILY_SIGNALS_KOKORO_TIMEOUT_SECONDS=30
# The podcast feed is an explicit operator choice; absent configuration keeps it private.
DAILY_SIGNALS_PODCAST_FEED_ENABLED=true
DAILY_SIGNALS_PODCAST_FEED_LOCALE=en
STREAMER_BIND_ADDRESS=0.0.0.0
# Listener-readable object key prefixes; drafts and staging objects stay private.
# The published demo edition is served from the fixtures/ prefix.
STREAMER_PUBLIC_PREFIXES=editions/,fixtures/
# S3-compatible object-store location used by the publisher and streamer.
OBJECT_STORE_ENDPOINT=http://object-store:9000
OBJECT_STORE_BUCKET=daily-signals
OBJECT_STORE_MANIFEST_KEY=editions/demo.json
# Local compose credentials. Real installations inject both values from secrets.
OBJECT_STORE_ACCESS_KEY=daily-signals-local
OBJECT_STORE_SECRET_KEY=daily-signals-local-only
